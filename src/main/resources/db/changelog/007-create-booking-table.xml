<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="007-create-booking-table" author="Vinayak">
        <createTable tableName="booking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="booking_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="show_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>
        <addForeignKeyConstraint
                constraintName="fk_booking_show"
                baseTableName="booking"
                baseColumnNames="show_id"
                referencedTableName="show"
                referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                constraintName="fk_booking_user"
                baseTableName="booking"
                baseColumnNames="user_id"
                referencedTableName="user"
                referencedColumnNames="id"
        />
        <rollback>
            <dropTable tableName="booking"/>
        </rollback>

    </changeSet>

</databaseChangeLog>