<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="009-create-ticket-table" author="Vinayak">
        <createTable tableName="ticket">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="booking_id" type="BIGINT" >
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="issued_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="qr_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <addForeignKeyConstraint
                constraintName="fk_ticket_booking"
                baseTableName="ticket"
                baseColumnNames="booking_id"
                referencedTableName="booking"
                referencedColumnNames="id"
        />
        <rollback>
            <dropTable tableName="ticket"/>
        </rollback>

    </changeSet>

</databaseChangeLog>