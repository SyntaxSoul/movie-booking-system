<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="008-create-booked_seat-table" author="Vinayak">
        <createTable tableName="booked_seat">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="seat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <addForeignKeyConstraint
                constraintName="fk_booked_seat_seat"
                baseTableName="booked_seat"
                baseColumnNames="seat_id"
                referencedTableName="seat"
                referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                constraintName="fk_booked_seat_booking"
                baseTableName="booked_seat"
                baseColumnNames="booking_id"
                referencedTableName="booking"
                referencedColumnNames="id"
        />
        <addUniqueConstraint
                constraintName="uq_booked_seat_booking_id_seat_id"
                tableName="booked_seat"
                columnNames="booking_id, seat_id"
        />
        <rollback>
            <dropTable tableName="booked_seat"/>
        </rollback>

    </changeSet>

</databaseChangeLog>