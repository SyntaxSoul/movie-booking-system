<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="010-create-feedback-table" author="Vinayak">
        <createTable tableName="feedback">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="ticket_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="theatre_rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="movie_rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT">
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <addForeignKeyConstraint
                constraintName="fk_feedback_ticket"
                baseTableName="feedback"
                baseColumnNames="ticket_id"
                referencedTableName="ticket"
                referencedColumnNames="id"
        />
        <rollback>
            <dropTable tableName="feedback"/>
        </rollback>

    </changeSet>

</databaseChangeLog>