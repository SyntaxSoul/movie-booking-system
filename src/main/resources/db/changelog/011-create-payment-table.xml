<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="011-create-payment-table" author="Vinayak">
        <createTable tableName="payment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_response" type="VARCHAR(255)">
            </column>
            <column name="status" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <addForeignKeyConstraint
                constraintName="fk_payment_booking"
                baseTableName="payment"
                baseColumnNames="booking_id"
                referencedTableName="booking"
                referencedColumnNames="id"
        />

        <rollback>
            <dropTable tableName="payment"/>
        </rollback>

    </changeSet>

</databaseChangeLog>